{
  "expo": {
    "name": "Anotador",
    "slug": "anotador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Anotador necesita acceder a tu ubicación para registrar dónde se encuentra el local."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Anotador necesita acceder a tus fotos para mostrar una imagen en la ficha del faltante.",
          "cameraPermission": "Anotador necesita acceder a tu cámara para fotografiar la góndola.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Anotador necesita acceder a tu cámara para fotografiar la góndola.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
